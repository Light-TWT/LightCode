# LightCode 后端环境变量示例（开发模板）
#
# 用法：复制为 backend/.env（该文件已被 .gitignore 忽略，绝不提交）并按需填写；
# 也可以不建 .env，直接在 shell 中 export 后再启动后端。
# 本文件 .env.example 本身是模板，允许提交到仓库。
#
# 注意：任何 KEY/TOKEN 字段都请留空或填占位值，不要提交真实机密。

# --- 数据库 ---
# SQLite 数据库路径（相对路径以 backend/ 为基准）。默认: backend/data/lightcode.db
LIGHTCODE_DATABASE_PATH=

# --- 工作区注册 ---
# 静态工作区注册配置文件路径（内含机器特定 rootPath，真实文件已被忽略，绝不提交）
# 默认: backend/workspaces.json
LIGHTCODE_WORKSPACES_CONFIG=

# --- 模型 Provider（默认关闭，需显式开启） ---
# 置为 1/true 开启模型能力；不设置则模型功能禁用
LIGHTCODE_MODEL_ENABLED=
# Provider 类型，默认 openai-compatible
LIGHTCODE_MODEL_PROVIDER=openai-compatible
# OpenAI-compatible 服务地址（例如 https://api.openai.com/v1）
LIGHTCODE_MODEL_BASE_URL=
# API Key（机密，不要提交真实值）
LIGHTCODE_MODEL_API_KEY=
# 模型 ID
LIGHTCODE_MODEL_ID=
# 逗号分隔的允许 origin；留空则仅接受设置表单中用户显式提交的 origin
LIGHTCODE_MODEL_ALLOWED_ORIGINS=
# 超时（秒）与预算，按需调整
LIGHTCODE_MODEL_CONNECT_TIMEOUT_SECONDS=
LIGHTCODE_MODEL_READ_TIMEOUT_SECONDS=
LIGHTCODE_MODEL_TOTAL_TIMEOUT_SECONDS=
LIGHTCODE_MODEL_MAX_TOOL_ROUNDS=
LIGHTCODE_MODEL_MAX_INPUT_BYTES=
LIGHTCODE_MODEL_MAX_OUTPUT_TOKENS=
LIGHTCODE_MODEL_MAX_REQUESTS_PER_TASK=
LIGHTCODE_MODEL_MAX_CONCURRENT_TASKS=
# 开发期允许 HTTP（默认不启用，生产保持关闭）
LIGHTCODE_MODEL_ALLOW_INSECURE_HTTP=

# --- 可观测性 ---
# 日志级别: DEBUG / INFO / WARNING / ERROR（默认 WARNING）
LIGHTCODE_LOG_LEVEL=
# 日志格式: json（默认）/ text
LIGHTCODE_LOG_FORMAT=

# --- SSE ---
LIGHTCODE_SSE_REPLAY_CAP=1000
LIGHTCODE_SSE_TAIL_SECONDS=30
LIGHTCODE_SSE_HEARTBEAT_SECONDS=10
LIGHTCODE_SSE_POLL_SECONDS=0.5
LIGHTCODE_SSE_MAX_CONNECTIONS=50

# --- 浏览令牌 ---
LIGHTCODE_BROWSE_TOKEN_TTL_SECONDS=30
# 浏览令牌签名密钥（机密；不设置时使用派生默认值）
LIGHTCODE_BROWSE_TOKEN_SECRET=

# --- 技能 ---
# 技能数据目录（默认 backend/data/skills/，已被忽略）
LIGHTCODE_SKILLS_PATH=

# --- 桌面模式（sidecar，一般由 Electron 注入，无需手填） ---
# 设置后进入桌面模式；以下两项由 Electron 主进程在启动时注入
LIGHTCODE_DESKTOP_DATA_DIR=
LIGHTCODE_SIDECAR_TOKEN=
LIGHTCODE_SIDECAR_PORT=

# --- 前端（供参考，实际由 frontend/ 使用，不在此文件生效） ---
# VITE_LIGHTCODE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# 桌面模式下前端优先读取 Electron 桥暴露的 loopback 地址，无需设置。
